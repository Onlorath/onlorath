PORT=8080
# production: refuses to start without strong JWT secrets
APP_ENV=development
# A full connection URI (e.g. Supabase session pooler) overrides the DB_* values below
DATABASE_URL=
DB_MAX_OPEN_CONNS=10
DB_HOST=localhost
DB_PORT=5432
DB_USER=onlorath_admin
DB_PASSWORD=super_secret_password_123
DB_NAME=onlorath_db
DB_SSLMODE=disable

JWT_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=168h # 7 days
CLIENT_URL=http://localhost:3000

GEMINI_API_KEY=your_gemini_api_key_here
CHAT_USER_LIMIT=15
CHAT_GLOBAL_LIMIT=50

# Admin panel account, created (or promoted to admin) at API startup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_please
# Public sign-up stays closed unless this is true
ALLOW_REGISTRATION=false
# Set to true behind HTTPS so the refresh cookie is Secure
COOKIE_SECURE=false

# Uploads (images, PDF CV, mp4/webm video). Local disk unless Supabase Storage is configured.
UPLOAD_DIR=assets/uploads
UPLOAD_MAX_MB=25
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=uploads

# Optional contact form notifications (messages are always stored in the admin inbox)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
